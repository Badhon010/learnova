# ─── Learnova Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit your real .env to version control.

# Django secret key — generate a new one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=learnova-dev-secret-key-change-in-production

# Set to False in production
DEBUG=True

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Switch EMAIL_BACKEND to smtp for real sending.
# While developing, the console backend prints emails to the terminal.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Your sending Gmail address (or any SMTP account):
EMAIL_HOST_USER=your-email@gmail.com

# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (Requires 2FA to be enabled on your Google account)
EMAIL_HOST_PASSWORD=your-app-password-here

# Displayed as the "From" name in outgoing emails:
DEFAULT_FROM_EMAIL=Learnova <noreply@learnova.dev>

# Where contact-form submissions are forwarded (defaults to EMAIL_HOST_USER if blank):
CONTACT_EMAIL=your-email@gmail.com
