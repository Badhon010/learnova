# Copy this file to .env for local development, or configure the same
# variables in PythonAnywhere's Web > Environment variables section.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# SMTP settings. Use the credentials supplied by your email provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=badhonemail001@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=Learnova <badhonemail001@gmail.com>
CONTACT_EMAIL=badhonemail001@gmail.com
EMAIL_TIMEOUT=20

# Keep this false until HTTPS is active on the deployed site.
SECURE_SSL_REDIRECT=True

# Authentication is handled by django-allauth.
ACCOUNT_EMAIL_VERIFICATION=mandatory
SITE_ID=1
